<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ header.name }} -- Resume</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap');

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

@page {
  size: {{ 'letter' if page_format == 'letter' else 'A4' }};
  margin: 0;
}

html, body {
  font-family: 'EB Garamond', 'Times New Roman', serif;
  font-size: 10.5pt;
  line-height: 1.2;
  color: #111;
  background: #fff;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  /* No ligatures or contextual alternates: those glyphs carry no Unicode mapping, so
     a PDF reader extracts "workflows" as "work\x00ows" and "(RAG)" as "\x00RAG)", and a
     resume parser sees broken words. Separate glyphs cost nothing here and always extract. */
  font-variant-ligatures: none;
  font-feature-settings: "liga" 0, "clig" 0, "calt" 0, "dlig" 0, "hlig" 0;
  text-rendering: optimizeSpeed;
}

.page {
  width: {{ '8.5in' if page_format == 'letter' else '210mm' }};
  padding: 0.5in 0.55in;
  margin: 0 auto;
}

/* R4-T3-01: the trailing whitespace of the flow (the page block's bottom padding
   and the last entry's bottom margin) is counted against the final line at a page
   break, pushing it onto a near-blank second page. None of it paints, so drop it
   when paginating; the HTML preview keeps its bottom gutter. */
@media print {
  .page { padding-bottom: 0; }
  .entry:last-child, .edu-entry:last-child, .skill-line:last-child { margin-bottom: 0; }
  .section-title { break-after: avoid; }
}

/* --- Header: left-aligned, name + title inline --- */
.header {
  border-bottom: 1px solid #333;
  padding-bottom: 5pt;
  margin-bottom: 8pt;
}

.header .name-row {
  display: flex;
  align-items: baseline;
  gap: 8pt;
}

.header h1 {
  font-size: 18pt;
  font-weight: 600;
  letter-spacing: 0.5px;
  line-height: 1;
}

.header .title-text {
  font-size: 10.5pt;
  font-weight: 400;
  color: #444;
  font-style: italic;
  border-left: 1.5px solid #999;
  padding-left: 8pt;
}

.header .contact {
  font-size: 9.5pt;
  color: #444;
  margin-top: 3pt;
}

.header .contact a { color: #444; text-decoration: none; }
.header .contact .sep { margin: 0 5pt; color: #bbb; }

/* --- Section --- */
.section { margin-top: 8pt; }

.section-title {
  font-size: 11pt;
  font-weight: 600;
  color: #222;
  border-bottom: 0.5px solid #bbb;
  padding-bottom: 1.5pt;
  margin-bottom: 4pt;
}

/* --- Summary --- */
.summary-text {
  font-size: 10.5pt;
  line-height: 1.25;
  color: #222;
}

/* --- Experience --- */
.entry { margin-bottom: 5pt; }

.entry-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.entry-title { font-weight: 600; font-size: 10.5pt; }
.entry-date {
  font-size: 10pt;
  color: #555;
  text-align: right;
  white-space: nowrap;
  margin-left: 8pt;
}

.entry-sub {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.entry-company {
  font-style: italic;
  font-size: 10pt;
  color: #333;
}
.entry-location {
  font-size: 9.5pt;
  color: #555;
  text-align: right;
  white-space: nowrap;
  margin-left: 8pt;
}

.entry-description {
  margin-top: 1pt;
  font-size: 10pt;
  color: #444;
}

.entry-url {
  font-size: 9pt;
  color: #555;
  margin-top: 1pt;
}
.entry-url a { color: #555; text-decoration: none; }

ul.bullets {
  list-style: none;
  margin-left: 2pt;
  margin-top: 2pt;
}

ul.bullets li {
  margin-bottom: 1.5pt;
  font-size: 10.5pt;
  line-height: 1.15;
  padding-left: 12pt;
  text-indent: -11pt;
}

ul.bullets li::before {
  content: "\25B8";
  font-size: 7pt;
  margin-right: 5pt;
  color: #888;
  vertical-align: 1pt;
}

/* --- Skills --- */
.skill-line {
  font-size: 10pt;
  margin-bottom: 1pt;
  line-height: 1.15;
}
.skill-label { font-weight: 600; }

/* --- Education --- */
.edu-entry { margin-bottom: 4pt; }
.edu-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}
.edu-school { font-weight: 600; font-size: 10.5pt; }
.edu-location {
  font-size: 9.5pt;
  color: #555;
  text-align: right;
  white-space: nowrap;
  margin-left: 8pt;
}
.edu-degree { font-size: 10pt; color: #333; font-style: italic; }
/* Each contact item is unbreakable: the line may wrap between items, never inside
   one. Without this the browser wraps at any space -- including the ones inside
   "+91 78421 32657" and "Hyderabad, Telangana, India" -- and a resume parser reads
   the halves as two separate tokens instead of one phone number or one city. */
.contact .ci { white-space: nowrap; }
/* Hyphenated compounds never split across lines: a trailing "processed-" is stripped by
   any reader that reflows wrapped text, which turns "processed-event" into one word. */
.nb { white-space: nowrap; }
</style>
</head>
<body>
<div class="page">

  {% if header %}
  <div class="header">
    <div class="name-row">
      <h1>{{ header.name }}</h1>
      {% if header.title %}<span class="title-text">{{ header.title }}</span>{% endif %}
    </div>
    <div class="contact">
      {% set contact_parts = [] %}
      {% for item in (header.contact_items or []) %}
        {% if item.url %}
          {% set href = item.url if (item.url.startswith('http') or item.url.startswith('mailto')) else 'https://' ~ item.url %}
          {% set _ = contact_parts.append('<span class="ci"><a href="' ~ href ~ '">' ~ item.text ~ '</a></span>') %}
        {% else %}
          {% set _ = contact_parts.append('<span class="ci">' ~ item.text ~ '</span>') %}
        {% endif %}
      {% endfor %}
      {{ contact_parts | join('<span class="sep">&bull;</span><wbr>') }}
    </div>
  </div>
  {% endif %}

  {% if summary %}
  <div class="section" style="margin-top: 0">
    {% if ats_layout %}<div class="section-title">Professional Summary</div>{% endif %}
    <div class="summary-text">{{ summary | nb }}</div>
  </div>
  {% endif %}

  {# Skills render once, placed by layout: after Experience by default, before it in a
     tailored copy's ATS layout (Header, Professional Summary, Technical Skills, Work
     Experience, Projects, Education, Certifications). #}
  {% set skills_section %}
  {% if skills %}
  <div class="section">
    <div class="section-title">{{ 'Technical Skills' if ats_layout else 'Skills' }}</div>
    {% if skills is mapping %}
      {% for label, value in skills.items() %}
      <div class="skill-line"><span class="skill-label">{{ label }}:</span> {{ value | nb }}</div>
      {% endfor %}
    {% else %}
      {% for sk in skills %}
      <div class="skill-line"><span class="skill-label">{{ sk.category }}:</span> {{ sk.items | nb }}</div>
      {% endfor %}
    {% endif %}
  </div>
  {% endif %}
  {% endset %}
  {% if ats_layout %}{{ skills_section }}{% endif %}

  {% if experience %}
  <div class="section">
    <div class="section-title">{{ 'Work Experience' if ats_layout else 'Experience' }}</div>
    {% for job in experience %}
    <div class="entry">
      <div class="entry-header">
        <span class="entry-title">{{ job.title }}</span>
        <span class="entry-date">{{ job.date }}</span>
      </div>
      <div class="entry-sub">
        <span class="entry-company">{{ job.company }}</span>
        <span class="entry-location">{{ job.location }}</span>
      </div>
      {% if job.description %}
      <div class="entry-description">{{ job.description | nb }}</div>
      {% endif %}
      {% if job.bullets %}
      <ul class="bullets">
        {% for bullet in job.bullets %}
        <li>{{ bullet | bold }}</li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {# Projects render once, placed by layout: after Education by default, right after
     Work Experience in a tailored copy's ATS layout. #}
  {% set projects_section %}
  {% if projects %}
  <div class="section">
    <div class="section-title">Projects</div>
    {% for project in projects %}
    <div class="entry">
      <div class="entry-title">{{ project.name or project.title }}</div>
      {% if project.url %}<div class="entry-url"><a href="{{ project.url }}">{{ project.url }}</a></div>{% endif %}
      {% if project.description %}<div class="entry-description">{{ project.description | nb }}</div>{% endif %}
      {% if project.bullets %}
      <ul class="bullets">
        {% for bullet in project.bullets %}<li>{{ bullet | bold }}</li>{% endfor %}
      </ul>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}
  {% endset %}
  {% if ats_layout %}{{ projects_section }}{% endif %}

  {% if not ats_layout %}{{ skills_section }}{% endif %}

  {% if education %}
  <div class="section">
    <div class="section-title">Education</div>
    {% for edu in education %}
    <div class="edu-entry">
      <div class="edu-row">
        <span class="edu-school">{{ edu.school }}</span>
        {% if not ats_layout %}<span class="edu-location">{{ edu.location }}</span>{% endif %}
      </div>
      {# The graduation date prints on the degree line, never in a right-hand column: a
         parser ties a date to the text nearest it, and one a column away reads as the
         school's rather than the degree's. #}
      {% set edu_line = [edu.degree, edu.years if ats_layout else '', edu.grade] | select | join(' · ') %}
      {% if edu_line %}<div class="edu-degree">{{ edu_line | nb }}</div>{% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if certifications %}
  <div class="section">
    <div class="section-title">Certifications</div>
    <ul class="bullets">
      {% for cert in certifications %}<li>{{ cert | bold }}</li>{% endfor %}
    </ul>
  </div>
  {% endif %}

  {% if not ats_layout %}{{ projects_section }}{% endif %}

  {% if publications %}
  <div class="section">
    <div class="section-title">Publications</div>
    {% for pub in publications %}
    <div class="entry">
      <div class="entry-title">{{ pub.name or pub.title }}</div>
      {% if pub.description %}<div class="entry-description">{{ pub.description }}</div>{% endif %}
      {% if pub.bullets %}
      <ul class="bullets">
        {% for bullet in pub.bullets %}<li>{{ bullet | bold }}</li>{% endfor %}
      </ul>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}

</div>
</body>
</html>
