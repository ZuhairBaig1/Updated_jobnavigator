<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ header.name }} -- Resume</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap');

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

@page {
  size: {{ 'letter' if page_format == 'letter' else 'A4' }};
  margin: 0;
}

html, body {
  font-family: 'IBM Plex Sans', 'Helvetica Neue', Helvetica, Arial, sans-serif;
  font-size: 9.5pt;
  line-height: 1.25;
  color: #222;
  background: #fff;
  -webkit-font-smoothing: antialiased;
  /* No ligatures or contextual alternates: those glyphs carry no Unicode mapping, so
     a PDF reader extracts "workflows" as "work\x00ows" and "(RAG)" as "\x00RAG)", and a
     resume parser sees broken words. Separate glyphs cost nothing here and always extract. */
  font-variant-ligatures: none;
  font-feature-settings: "liga" 0, "clig" 0, "calt" 0, "dlig" 0, "hlig" 0;
  text-rendering: optimizeSpeed;
}

.page {
  width: {{ '8.5in' if page_format == 'letter' else '210mm' }};
  padding: 0.45in 0.55in;
  margin: 0 auto;
}

/* R4-T3-01: the trailing whitespace of the flow (the page block's bottom padding
   and the last entry's bottom margin) is counted against the final line at a page
   break, pushing it onto a near-blank second page. None of it paints, so drop it
   when paginating; the HTML preview keeps its bottom gutter. */
@media print {
  .page { padding-bottom: 0; }
  .entry:last-child, .edu-entry:last-child, .skill-line:last-child { margin-bottom: 0; }
  .section-title { break-after: avoid; }
}

/* --- Header --- */
.header {
  margin-bottom: 8pt;
}

.header h1 {
  font-size: 22pt;
  font-weight: 700;
  color: #111;
  line-height: 1;
  margin-bottom: 3pt;
}

.header .title-line {
  font-size: 10pt;
  color: #555;
  margin-bottom: 4pt;
}

.header .contact {
  font-size: 8.5pt;
  color: #666;
  display: flex;
  flex-wrap: wrap;
  gap: 0 14pt;
  line-height: 1.6;
}

.header .contact a { color: #666; text-decoration: none; }

/* --- Section --- */
.section { margin-top: 10pt; }

.section-title {
  font-size: 8.5pt;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: normal;
  color: #888;
  margin-bottom: 5pt;
}

/* --- Summary --- */
.summary-text {
  font-size: 9.5pt;
  line-height: 1.35;
  color: #333;
  border-left: 2.5px solid #ddd;
  padding-left: 10pt;
}

/* --- Experience --- */
.entry { margin-bottom: 7pt; }

.entry-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.entry-primary {
  font-weight: 600;
  font-size: 10pt;
  color: #111;
}
.entry-date {
  font-size: 8.5pt;
  font-weight: 500;
  color: #888;
  text-align: right;
  white-space: nowrap;
  margin-left: 8pt;
}
.entry-secondary {
  font-size: 9pt;
  font-weight: 500;
  color: #555;
}
.entry-location {
  font-size: 8.5pt;
  color: #888;
  text-align: right;
  white-space: nowrap;
  margin-left: 8pt;
}

.entry-description {
  margin-top: 2pt;
  font-size: 9pt;
  color: #555;
}

.entry-url {
  font-size: 8pt;
  color: #888;
  margin-top: 1pt;
}
.entry-url a { color: #888; text-decoration: none; }

ul.bullets {
  list-style: none;
  margin-left: 0;
  margin-top: 3pt;
}

ul.bullets li {
  margin-bottom: 2pt;
  font-size: 9.5pt;
  line-height: 1.2;
  padding-left: 10pt;
  position: relative;
}

ul.bullets li::before {
  content: "";
  position: absolute;
  left: 0;
  top: 5pt;
  width: 3pt;
  height: 3pt;
  background: #bbb;
  border-radius: 50%;
}

/* --- Skills --- */
.skills-grid {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 1pt 12pt;
  font-size: 9.5pt;
}
.skill-label {
  font-weight: 600;
  color: #333;
  white-space: nowrap;
}
.skill-value { color: #555; }

/* --- Education --- */
.edu-entry { margin-bottom: 4pt; }
.edu-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}
.edu-school { font-weight: 600; font-size: 9.5pt; color: #111; }
.edu-location {
  font-size: 8.5pt;
  color: #888;
  text-align: right;
  white-space: nowrap;
  margin-left: 8pt;
}
.edu-degree { font-size: 9pt; color: #555; }
/* Each contact item is unbreakable: the line may wrap between items, never inside
   one. Without this the browser wraps at any space -- including the ones inside
   "+91 78421 32657" and "Hyderabad, Telangana, India" -- and a resume parser reads
   the halves as two separate tokens instead of one phone number or one city. */
.contact .ci { white-space: nowrap; }
/* Hyphenated compounds never split across lines: a trailing "processed-" is stripped by
   any reader that reflows wrapped text, which turns "processed-event" into one word. */
.nb { white-space: nowrap; }
</style>
</head>
<body>
<div class="page">

  {% if header %}
  <div class="header">
    <h1>{{ header.name }}</h1>
    {# R3-B-01: optional headline. Absent when empty, so nothing shifts. #}
    {% if header.title %}<div class="title-line">{{ header.title }}</div>{% endif %}
    <div class="contact">
      {% for item in (header.contact_items or []) %}
        {% if item.url %}
          {% set href = item.url if (item.url.startswith('http') or item.url.startswith('mailto')) else 'https://' ~ item.url %}
          <span class="ci"><a href="{{ href }}">{{ item.text }}</a></span>
        {% else %}
          <span class="ci">{{ item.text }}</span>
        {% endif %}
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if summary %}
  <div class="section" style="margin-top: 2pt">
    {% if ats_layout %}<div class="section-title">Professional Summary</div>{% endif %}
    <div class="summary-text">{{ summary | nb }}</div>
  </div>
  {% endif %}

  {# Skills render once, placed by layout: after Experience by default, before it in a
     tailored copy's ATS layout (Header, Professional Summary, Technical Skills, Work
     Experience, Projects, Education, Certifications). #}
  {% set skills_section %}
  {% if skills %}
  <div class="section">
    <div class="section-title">{{ 'Technical Skills' if ats_layout else 'Skills' }}</div>
    <div class="skills-grid">
      {% if skills is mapping %}
        {% for label, value in skills.items() %}
        <span class="skill-label">{{ label }}</span>
        <span class="skill-value">{{ value | nb }}</span>
        {% endfor %}
      {% else %}
        {% for sk in skills %}
        <span class="skill-label">{{ sk.category }}</span>
        <span class="skill-value">{{ sk.items | nb }}</span>
        {% endfor %}
      {% endif %}
    </div>
  </div>
  {% endif %}
  {% endset %}
  {% if ats_layout %}{{ skills_section }}{% endif %}

  {% if experience %}
  <div class="section">
    <div class="section-title">{{ 'Work Experience' if ats_layout else 'Experience' }}</div>
    {% for job in experience %}
    <div class="entry">
      <div class="entry-row">
        <span class="entry-primary">{{ job.title }}{% if job.company %} <span style="font-weight:400;color:#888">at</span> {{ job.company }}{% endif %}</span>
        <span class="entry-date">{{ job.date }}</span>
      </div>
      {% if job.location %}
      <div style="font-size: 8.5pt; color: #888;">{{ job.location }}</div>
      {% endif %}
      {% if job.description %}
      <div class="entry-description">{{ job.description | nb }}</div>
      {% endif %}
      {% if job.bullets %}
      <ul class="bullets">
        {% for bullet in job.bullets %}
        <li>{{ bullet | bold }}</li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {# Projects render once, placed by layout: after Education by default, right after
     Work Experience in a tailored copy's ATS layout. #}
  {% set projects_section %}
  {% if projects %}
  <div class="section">
    <div class="section-title">Projects</div>
    {% for project in projects %}
    <div class="entry">
      <div class="entry-primary">{{ project.name or project.title }}</div>
      {% if project.url %}<div class="entry-url"><a href="{{ project.url }}">{{ project.url }}</a></div>{% endif %}
      {% if project.description %}<div class="entry-description">{{ project.description | nb }}</div>{% endif %}
      {% if project.bullets %}
      <ul class="bullets">
        {% for bullet in project.bullets %}<li>{{ bullet | bold }}</li>{% endfor %}
      </ul>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}
  {% endset %}
  {% if ats_layout %}{{ projects_section }}{% endif %}

  {% if not ats_layout %}{{ skills_section }}{% endif %}

  {% if education %}
  <div class="section">
    <div class="section-title">Education</div>
    {% for edu in education %}
    <div class="edu-entry">
      <div class="edu-row">
        <span class="edu-school">{{ edu.school }}</span>
        {% if not ats_layout %}<span class="edu-location">{{ edu.location }}</span>{% endif %}
      </div>
      {# The graduation date prints on the degree line, never in a right-hand column: a
         parser ties a date to the text nearest it, and one a column away reads as the
         school's rather than the degree's. #}
      {% set edu_line = [edu.degree, edu.years if ats_layout else '', edu.grade] | select | join(' · ') %}
      {% if edu_line %}<div class="edu-degree">{{ edu_line | nb }}</div>{% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if certifications %}
  <div class="section">
    <div class="section-title">Certifications</div>
    <ul class="bullets">
      {% for cert in certifications %}<li>{{ cert | bold }}</li>{% endfor %}
    </ul>
  </div>
  {% endif %}

  {% if not ats_layout %}{{ projects_section }}{% endif %}

  {% if publications %}
  <div class="section">
    <div class="section-title">Publications</div>
    {% for pub in publications %}
    <div class="entry">
      <div class="entry-primary">{{ pub.name or pub.title }}</div>
      {% if pub.description %}<div class="entry-description">{{ pub.description }}</div>{% endif %}
      {% if pub.bullets %}
      <ul class="bullets">
        {% for bullet in pub.bullets %}<li>{{ bullet | bold }}</li>{% endfor %}
      </ul>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}

</div>
</body>
</html>
