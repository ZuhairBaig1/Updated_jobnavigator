<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ header.name }} -- Resume</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Carlito:ital,wght@0,400;0,700;1,400;1,700&display=swap');

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

@page {
  size: {{ 'letter' if page_format == 'letter' else 'A4' }};
  margin: 0;
}

/* Carlito is metric-compatible with Calibri, so this reads as a Word document
   wherever it is opened. */
html, body {
  font-family: 'Carlito', 'Calibri', 'Lato', 'Helvetica Neue', Arial, sans-serif;
  font-size: 10.5pt;
  line-height: 1.28;
  color: #000;
  background: #fff;
  -webkit-font-smoothing: antialiased;
  /* No ligatures: Carlito's "ti" ligature carries no Unicode mapping, so a PDF
     reader extracts "production" as "produc\x00on" and a résumé parser sees two
     broken words. Separate glyphs cost nothing here and always extract. */
  font-variant-ligatures: none;
  font-feature-settings: "liga" 0, "clig" 0, "calt" 0, "dlig" 0, "hlig" 0;
  text-rendering: optimizeSpeed;
}

.page {
  width: {{ '8.5in' if page_format == 'letter' else '210mm' }};
  padding: 0.6in 0.75in;   /* Word's default-ish margins */
  margin: 0 auto;
}

@media print {
  .page { padding-bottom: 0; }
  .entry:last-child, .edu-entry:last-child { margin-bottom: 0; }
  .section-title { break-after: avoid; }
  .entry-head { break-after: avoid; }
}

/* --- Header: centred, as a Word résumé prints it --- */
.header { text-align: center; margin-bottom: 11pt; }

.header h1 {
  font-size: 19pt;
  font-weight: 700;
  /* No tracking anywhere in this template: letter-spacing makes a PDF's text
     layer extract as "N A M E", which résumé parsers read as separate words. */
  letter-spacing: normal;
  line-height: 1.1;
  margin-bottom: 2pt;
}

.header .title-line {
  font-size: 11pt;
  font-weight: 700;
  margin-bottom: 3pt;
}

.header .contact {
  font-size: 10pt;
  line-height: 1.35;
}

.header .contact a { color: #000; text-decoration: none; }
.header .contact .sep { padding: 0 4pt; }

/* --- Sections: bold heading over a rule, the Word house style --- */
.section { margin-top: 11pt; }

.section-title {
  font-size: 11pt;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: normal;
  border-bottom: 1px solid #000;
  padding-bottom: 1pt;
  margin-bottom: 5pt;
}

.summary-text { font-size: 10.5pt; line-height: 1.3; }

/* --- Entries --- */
.entry { margin-bottom: 8pt; }

.entry-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 12pt;
  /* Roomy lines keep a right-hand date from being grouped with the line under it
     when a parser reconstructs lines from the text layer. */
  line-height: 1.4;
}

.entry-primary { font-weight: 700; }
.entry-secondary { font-style: italic; }
.entry-date, .entry-location { white-space: nowrap; }

.entry-description { font-style: italic; margin-bottom: 1pt; }

.entry-url a { color: #000; text-decoration: none; }

/* Bullets are written into the markup as real "•" characters (see below), so
   list-style stays off: a CSS marker is drawn, not typed, and never lands in
   the text layer a résumé parser reads. */
ul.bullets { list-style: none; margin: 2pt 0 0 0; }

ul.bullets li {
  display: flex;
  gap: 6pt;
  margin-bottom: 2pt;
  line-height: 1.3;
}

ul.bullets li .mark { flex: 0 0 auto; }

/* --- Skills --- */
.skill-line { margin-bottom: 2pt; line-height: 1.3; }
.skill-label { font-weight: 700; }

/* --- Education --- */
.edu-entry { margin-bottom: 6pt; }
.edu-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12pt; line-height: 1.4; }
.edu-school { font-weight: 700; }
.edu-degree { line-height: 1.3; }
/* Each contact item is unbreakable: the line may wrap between items, never inside
   one. Without this the browser wraps at any space -- including the ones inside
   "+91 78421 32657" and "Hyderabad, Telangana, India" -- and a resume parser reads
   the halves as two separate tokens instead of one phone number or one city. */
.contact .ci { white-space: nowrap; }
/* Hyphenated compounds never split across lines: a trailing "processed-" is stripped by
   any reader that reflows wrapped text, which turns "processed-event" into one word. */
.nb { white-space: nowrap; }
</style>
</head>
<body>
<div class="page">

  {% if header %}
  <div class="header">
    <h1>{{ header.name }}</h1>
    {% if header.title %}<div class="title-line">{{ header.title }}</div>{% endif %}
    <div class="contact">
      {% set contact_parts = [] %}
      {% for item in (header.contact_items or []) %}
        {% if item.url %}
          {% set href = item.url if (item.url.startswith('http') or item.url.startswith('mailto')) else 'https://' ~ item.url %}
          {% set _ = contact_parts.append('<span class="ci"><a href="' ~ href ~ '">' ~ item.text ~ '</a></span>') %}
        {% else %}
          {% set _ = contact_parts.append('<span class="ci">' ~ item.text ~ '</span>') %}
        {% endif %}
      {% endfor %}
      {# A typed "|" separator, not a CSS one, so the contact line extracts whole. #}
      {{ contact_parts | join('<span class="sep">|</span><wbr>') }}
    </div>
  </div>
  {% endif %}

  {% if summary %}
  <div class="section">
    <div class="section-title">{{ 'Professional Summary' if ats_layout else 'Summary' }}</div>
    <div class="summary-text">{{ summary | nb }}</div>
  </div>
  {% endif %}

  {# Skills render once, placed by layout: after Experience by default, before it in a
     tailored copy's ATS layout (Header, Professional Summary, Technical Skills, Work
     Experience, Projects, Education, Certifications). #}
  {% set skills_section %}
  {% if skills %}
  <div class="section">
    <div class="section-title">{{ 'Technical Skills' if ats_layout else 'Skills' }}</div>
    {% if skills is mapping %}
      {% for label, value in skills.items() %}
      <div class="skill-line"><span class="skill-label">{{ label }}:</span> {{ value | nb }}</div>
      {% endfor %}
    {% else %}
      {% for sk in skills %}
      <div class="skill-line"><span class="skill-label">{{ sk.category }}:</span> {{ sk.items | nb }}</div>
      {% endfor %}
    {% endif %}
  </div>
  {% endif %}
  {% endset %}
  {% if ats_layout %}{{ skills_section }}{% endif %}

  {% if experience %}
  <div class="section">
    <div class="section-title">{{ 'Work Experience' if ats_layout else 'Experience' }}</div>
    {% for job in experience %}
    <div class="entry">
      <div class="entry-head">
        <span class="entry-primary">{{ job.title }}</span>
        <span class="entry-date">{{ job.date }}</span>
      </div>
      <div class="entry-head">
        <span class="entry-secondary">{{ job.company }}</span>
        <span class="entry-location">{{ job.location }}</span>
      </div>
      {% if job.description %}
      <div class="entry-description">{{ job.description | nb }}</div>
      {% endif %}
      {% if job.bullets %}
      <ul class="bullets">
        {% for bullet in job.bullets %}
        <li><span class="mark">&bull;</span><span>{{ bullet | bold }}</span></li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {# Projects render once, placed by layout: after Education by default, right after
     Work Experience in a tailored copy's ATS layout. #}
  {% set projects_section %}
  {% if projects %}
  <div class="section">
    <div class="section-title">Projects</div>
    {% for project in projects %}
    <div class="entry">
      <div class="entry-head"><span class="entry-primary">{{ project.name or project.title }}</span></div>
      {% if project.description %}<div class="entry-description">{{ project.description | nb }}</div>{% endif %}
      {% if project.url %}<div class="entry-url"><a href="{{ project.url }}">{{ project.url }}</a></div>{% endif %}
      {% if project.bullets %}
      <ul class="bullets">
        {% for bullet in project.bullets %}
        <li><span class="mark">&bull;</span><span>{{ bullet | bold }}</span></li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}
  {% endset %}
  {% if ats_layout %}{{ projects_section }}{% endif %}

  {% if not ats_layout %}{{ skills_section }}{% endif %}

  {% if education %}
  <div class="section">
    <div class="section-title">Education</div>
    {% for edu in education %}
    <div class="edu-entry">
      <div class="edu-head">
        <span class="edu-school">{{ edu.school }}</span>
        {% if not ats_layout %}<span class="entry-location">{{ edu.location }}</span>{% endif %}
      </div>
      {# The graduation date prints on the degree line, never in a right-hand column: a
         parser ties a date to the text nearest it, and one a column away reads as the
         school's rather than the degree's. #}
      {% set edu_line = [edu.degree, edu.years if ats_layout else '', edu.grade] | select | join(' · ') %}
      {% if edu_line %}<div class="edu-degree">{{ edu_line | nb }}</div>{% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if certifications %}
  <div class="section">
    <div class="section-title">Certifications</div>
    <ul class="bullets">
      {% for cert in certifications %}
      <li><span class="mark">&bull;</span><span>{{ cert | bold }}</span></li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}

  {% if not ats_layout %}{{ projects_section }}{% endif %}

  {% if publications %}
  <div class="section">
    <div class="section-title">Publications</div>
    {% for pub in publications %}
    <div class="entry">
      <div class="entry-head"><span class="entry-primary">{{ pub.name or pub.title }}</span></div>
      {% if pub.description %}<div class="entry-description">{{ pub.description }}</div>{% endif %}
      {% if pub.bullets %}
      <ul class="bullets">
        {% for bullet in pub.bullets %}
        <li><span class="mark">&bull;</span><span>{{ bullet | bold }}</span></li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}

</div>
</body>
</html>
